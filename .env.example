# CAPRA environment configuration
# Copy this file to .env and fill in your keys. NEVER commit the real .env.

# VirusTotal v3 API key (optional - CAPRA falls back to offline hash DB without it)
# Get a free key at: https://www.virustotal.com/gui/my-apikey
VIRUSTOTAL_API_KEY=

# Optional: MalwareBazaar API key (reserved for future threat-intel sources)
MALWAREBAZAAR_API_KEY=

# Logging verbosity: DEBUG, INFO, WARNING, ERROR (default: INFO)
CAPRA_LOG_LEVEL=INFO

# APK input hardening limits (untrusted-input safety)
# CAPRA_MAX_APK_SIZE_MB=500
# CAPRA_MAX_ZIP_ENTRIES=100000
# CAPRA_MAX_UNCOMPRESSED_MB=4000
# CAPRA_MAX_COMPRESSION_RATIO=200
# CAPRA_APK_PARSE_TIMEOUT=120
# CAPRA_STATIC_ANALYSIS_TIMEOUT=300
